# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
TRUST_PROXY=0
REQUEST_BODY_LIMIT=100kb

# ─── PostgreSQL ───────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:password@localhost:5432/laptop_store
# Use require in production. Use disable only for local PostgreSQL without TLS.
DATABASE_SSL_MODE=disable
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=15000

# ─── JSON Web Token ───────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_very_long_random_secret_string
JWT_EXPIRES_IN=15m
JWT_ISSUER=prime-laptops-store
JWT_AUDIENCE=prime-laptops-store-client
REFRESH_TOKEN_DAYS=30
BCRYPT_SALT_ROUNDS=12

# ─── CORS ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
# Comma-separated production allowlist, for example:
# CLIENT_ORIGINS=https://your-frontend.example,https://admin.your-frontend.example
# Allow server-side clients without an Origin header (default: true in dev, false in prod)
# CORS_ALLOW_NO_ORIGIN=false

# ─── Metrics ─────────────────────────────────────────────────
# Optional bearer token for Prometheus/monitoring scrapers
# METRICS_SECRET=replace_with_a_long_random_metrics_secret

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
