{
  "name": "laptop-ecommerce-backend",
  "version": "1.0.0",
  "description": "RESTful API server for Multi-Brand Laptop E-Commerce Platform",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "pm2-runtime ecosystem.config.js --env production",
    "start:cluster": "pm2-runtime ecosystem.config.js --env production -i max",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs laptop-ecommerce-api",
    "check:syntax": "node --check server.js && node --check config/*.js && node --check controllers/*.js && node --check middleware/*.js && node --check routes/*.js && node --check utils/*.js",
    "check:deploy": "npm run check:syntax && npm audit --omit=dev",
    "test": "node --test test/**/*.test.js",
    "db:init": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ../database/schema.sql",
    "db:migrate": "for file in $(ls ../database/migrations/*.sql | sort); do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$file\"; done",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ../database/seeds.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pm2": "^7.0.1"
  }
}
